# Локальный запуск. На Render HOST не задавай — PORT Render назначит сам.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Сгенерируй свои ключи командой из PUSH_SETUP.md
VAPID_PUBLIC_KEY=замени-на-publicKey
VAPID_PRIVATE_KEY=замени-на-privateKey
VAPID_SUBJECT=mailto:admin@example.com
ADMIN_TOKEN=замени-на-длинный-случайный-секрет

# Сайты, которым разрешено обращаться к серверу (через запятую)
ALLOWED_ORIGINS=https://zaibat228.github.io
# Часовой пояс для тихих часов, если устройство не передало свой
DEFAULT_TIME_ZONE=Europe/Moscow
